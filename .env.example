# Bind on 0.0.0.0 for access from other devices on your tailnet.
HOST=0.0.0.0
PORT=8787

# Recommended. If set, requests must include this value as:
#   Authorization: Bearer <token>
# The browser app stores it in localStorage after the first prompt.
HERDR_REMOTE_TOKEN=

# Optional override when herdr is not on PATH for the service user.
HERDR_BIN=herdr
