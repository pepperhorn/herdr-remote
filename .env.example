# Copied to .env and read by the server on startup.
# Variables set in the real environment take precedence over .env.

# Bind address. Default 127.0.0.1 (this machine only).
# 0.0.0.0 makes it reachable from other devices on your tailnet.
HOST=0.0.0.0
PORT=8787

# Optional. If set, API requests must include:
#   Authorization: Bearer <token>
# The browser prompts once and remembers it.
# Recommended if your tailnet is shared with others.
HERDR_REMOTE_TOKEN=

# Herdr executable. Default: herdr (on PATH for the user running the server).
HERDR_BIN=herdr

# Optional, comma-separated extra hostnames the server will answer to,
# e.g. a custom DNS name or reverse proxy name. IP addresses, localhost,
# single-label names (Tailscale MagicDNS short names) and *.ts.net names
# are always allowed.
ALLOWED_HOSTS=
